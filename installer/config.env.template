# galois-edge daemon configuration
#
# All values can be overridden via environment variables of the same name.
# Lines starting with # are comments.
# Uncomment a line to override its default value.
#
# This file is installed to /etc/galois-edge/config.env (Linux) or
# C:\ProgramData\galois-edge\config.env (Windows).

# ---------------------------------------------------------------------------
# Edge identity
# ---------------------------------------------------------------------------

# Human-readable name for this edge node (default: system hostname)
# EDGE_NAME=lab-bench-1

# ---------------------------------------------------------------------------
# Cloud backend registration
# ---------------------------------------------------------------------------

# Cloud backend URL for registration and heartbeat
# BACKEND_URL=https://app.galois.dev

# One-time registration token (obtain from Galois dashboard)
# REGISTRATION_TOKEN=

# Relay WebSocket URL (derived from BACKEND_URL if not set)
# RELAY_URL=

# Heartbeat interval in seconds (default: 30)
# HEARTBEAT_INTERVAL_SEC=30

# ---------------------------------------------------------------------------
# Tailscale / Headscale network
# ---------------------------------------------------------------------------

# Tailscale or Headscale pre-auth key
# TAILSCALE_AUTH_KEY=

# Headscale control server URL (leave empty to use standard Tailscale)
# HEADSCALE_URL=

# Directory for tsnet persistent state (default: platform-specific)
# TSNET_STATE_DIR=

# ---------------------------------------------------------------------------
# gRPC ports
# ---------------------------------------------------------------------------

# External gRPC port exposed via tsnet / TCP proxy (default: 50051)
# GRPC_PORT=50051

# Internal port the Python gRPC server binds to on localhost (default: 50052)
# GRPC_INTERNAL_PORT=50052

# Python gRPC thread pool size (default: 10)
# GRPC_MAX_WORKERS=10

# ---------------------------------------------------------------------------
# WebSocket ports
# ---------------------------------------------------------------------------

# External WebSocket port exposed via tsnet / TCP proxy (default: 8765)
# WS_PORT=8765

# Internal port the Python WebSocket server binds to on localhost (default: 8766)
# WS_INTERNAL_PORT=8766

# Enable the WebSocket streaming server (default: true)
# WS_ENABLED=true

# ---------------------------------------------------------------------------
# Instrument profile system
# ---------------------------------------------------------------------------

# Enable YAML instrument profile loading (default: true)
# PROFILES_ENABLED=true

# Path to the directory containing YAML instrument profiles
# PROFILE_DIR=

# ---------------------------------------------------------------------------
# GPIB
# ---------------------------------------------------------------------------

# Enable GPIB bus scanning: true, false, or auto (default: auto — true on Linux)
# GPIB_ENABLED=auto

# linux-gpib board index (default: 0)
# GPIB_BOARD=0

# Scan GPIB bus at startup (default: true)
# GPIB_SCAN_ON_INIT=true

# ---------------------------------------------------------------------------
# LAN instrument discovery
# ---------------------------------------------------------------------------

# Enable LAN instrument discovery (default: true)
# LAN_ENABLED=true

# Enable mDNS/Zeroconf discovery (default: true)
# LAN_MDNS_ENABLED=true

# Static TCPIP VISA addresses, comma-separated
# LAN_INSTRUMENTS=TCPIP::192.168.1.10::INSTR,TCPIP::192.168.1.11::INSTR

# ---------------------------------------------------------------------------
# Raw USB transport
# ---------------------------------------------------------------------------

# Enable raw USB transport for vendor-specific devices (default: true)
# USB_RAW_ENABLED=true

# ---------------------------------------------------------------------------
# ZMQ streaming
# ---------------------------------------------------------------------------

# Enable ZMQ PUB streaming (default: false)
# ZMQ_ENABLED=false

# ZMQ PUB port (default: 5556)
# ZMQ_PUB_PORT=5556

# ---------------------------------------------------------------------------
# Instrument rescan
# ---------------------------------------------------------------------------

# Interval in seconds for periodic instrument rediscovery (default: 60)
# RESCAN_INTERVAL_SEC=60

# ---------------------------------------------------------------------------
# PyVISA backend
# ---------------------------------------------------------------------------

# PyVISA backend selector — e.g. "@py" for pyvisa-py, empty for default
# VISA_BACKEND=

# ---------------------------------------------------------------------------
# Connection retry / backoff
# ---------------------------------------------------------------------------

# Initial backoff in seconds for registration retries (default: 2.0)
# CONNECTION_INITIAL_BACKOFF=2.0

# Maximum backoff in seconds (default: 300.0)
# CONNECTION_MAX_BACKOFF=300.0

# Consecutive failures before entering backoff (default: 3)
# CONNECTION_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR (default: info)
# LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Passthrough / Python-engine-only settings
# ---------------------------------------------------------------------------
# These keys are passed through to the Python instrument engine.
# They are not typed Go config fields but are valid in config.env.

# Enable serial port inclusion in instrument scan (default: false)
# INCLUDE_SERIAL_PORTS=false

# Enable USB hotplug monitoring (default: true on Linux, false on Windows)
# USB_MONITOR_ENABLED=true

# GPIB trickle scanner interval in seconds (default: 2.0)
# GPIB_TRICKLE_INTERVAL_S=2.0

# GPIB trickle probe timeout in milliseconds (default: 1000)
# GPIB_TRICKLE_PROBE_TIMEOUT_MS=1000

# Path to Modbus/protocol driver profile directory
# DRIVER_PROFILE_DIR=

# Modbus instruments — JSON array of {profile, id, uri, slave_id}
# MODBUS_INSTRUMENTS=[]

# Serial instruments — JSON array of {profile, id, uri}
# SERIAL_INSTRUMENTS=[]

# Enable demo mode with virtual instruments (default: false)
# DEMO_MODE=false
